#!/bin/bash

sshcs_check_nonempty() {
  local filepath="$1"

  [ -e "${filepath}" ] && grep -q -v '^\s*\(#\|$\)' "${filepath}"
}

build() {
  local etc_crypttab="/etc/crypttab"
  local sshcs_authorized_keys="/etc/initcpio/sshcs_authorized_keys"
  local sshcs_env="/etc/initcpio/sshcs_env"
  local ssh_key_types=( "rsa" "ecdsa" "ed25519" )
  local dropbear_keyfile_prefix="/etc/dropbear/dropbear_"
  local dropbear_keyfile_suffix="_host_key"
  local openssh_keyfile_prefix="/etc/ssh/ssh_host_"
  local openssh_keyfile_suffix="_key"

  # Check we are needed
  if ! sshcs_check_nonempty "${sshcs_authorized_keys}"; then
    plain "There is no root key(s) in ${sshcs_authorized_keys}. Skipping."
    return 0
  fi
  if ! sshcs_check_nonempty "${etc_crypttab}"; then
    plain "There is no device in ${etc_crypttab}. Skipping."
    return 0
  fi

  umask 0022

  # Note: parts of this script (modules/binaries/files added) are the same than
  # other install scripts (/usr/lib/initcpio/install/):
  #   - 'encrypt': nominal support of encrypted volumes at boot time
  #   - 'net': network tools

  ## Modules
  # (from 'encrypt')
  add_module 'dm-crypt'
  add_module 'dm-integrity'
  if [[ $CRYPTO_MODULES ]]; then
    local mod
    for mod in $CRYPTO_MODULES; do
      add_module "$mod"
    done
  else
    add_all_modules '/crypto/'
  fi

  # (from 'net')
  add_checked_modules '/drivers/net/'


  ## Binaries
  # (from 'encrypt')
  add_binary 'cryptsetup'
  # cryptsetup calls pthread_create(), which dlopen()s libgcc_s.so.1
  # Note: at least necessary for LUKS v2 volumes.
  # Also see similar/related bug reports (e.g. https://bugs.debian.org/cgi-bin/bugreport.cgi?bug=950254).
  add_binary '/usr/lib/libgcc_s.so.1'

  # (from 'net')
  add_binary '/usr/lib/initcpio/ipconfig' '/bin/ipconfig'

  # (ours)
  # Note: dmsetup is necessary for device mapper features
  add_binary 'dmsetup'
  add_binary 'ip'
  add_binary 'ethtool'


  ## Other files
  # (from 'encrypt')
  # cryptsetup-related files
  map add_udev_rule \
      '10-dm.rules' \
      '13-dm-disk.rules' \
      '95-dm-notify.rules'

  # (ours)
  # Our script and options
  [ -e "${sshcs_env}" ] && add_file "${sshcs_env}"
  # Note: use /usr/local/bin, even though everything actually points to /usr/bin
  # in initramfs.
  add_file '/usr/lib/initcpio/hooks/ssh-cryptsetup-tools' '/usr/local/bin/ssh-cryptsetup-tools'

  # crypt partitions
  add_file "${etc_crypttab}"

  # SSH-related things
  build_ssh

  add_runscript
}

build_ssh() {
  add_file "${sshcs_authorized_keys}" '/root/.ssh/authorized_keys'

  local ssh_daemon_default=dropbear

  [ -e "${sshcs_env}" ] && . "${sshcs_env}"
  [ -z "${sshcs_opt_ssh_daemon}" ] && sshcs_opt_ssh_daemon=${ssh_daemon_default}

  if [ "${sshcs_opt_ssh_daemon}" != "dropbear" ] && [ "${sshcs_opt_ssh_daemon}" != "openssh" ]; then
    die "Unknown SSH daemon: ${sshcs_opt_ssh_daemon}"
  fi

  if [ "${sshcs_opt_ssh_daemon}" == "openssh" ]; then
    build_ssh_openssh
  else
    build_ssh_dropbear
  fi
}

build_ssh_dropbear() {
  if ! pacman -Qi dropbear >/dev/null 2>&1; then
    die "Package dropbear not installed"
  fi

  plain "Using dropbear SSH daemon"

  add_binary 'dropbear'

  mkdir -p $(dirname "${BUILDROOT}/${dropbear_keyfile_prefix}")

  # Setup server keys.
  local dropbear_keyfile
  local openssh_keyfile
  local fingerprint
  for keytype in "${ssh_key_types[@]}"; do
    dropbear_keyfile=${dropbear_keyfile_prefix}${keytype}${dropbear_keyfile_suffix}
    openssh_keyfile=${openssh_keyfile_prefix}${keytype}${openssh_keyfile_suffix}

    # Use existing dropbear keys if any.
    # Otherwise, prefer OpenSSH keys.
    # Or generate missing ones.
    if [ -e "${dropbear_keyfile}" ]; then
      quiet "Copying Dropbear ${keytype} host key ..."
      add_file "${dropbear_keyfile}"
    elif [ -e "${openssh_keyfile}" ]; then
      quiet "Converting OpenSSH ${keytype} host key for dropbear ..."
      dropbearconvert openssh dropbear "${openssh_keyfile}" "${BUILDROOT}/${dropbear_keyfile}" > /dev/null 2>&1
    elif [ ! -e "${dropbear_keyfile}" ]; then
      quiet "Generating ${keytype} host key for dropbear ..."
      dropbearkey -t "${keytype}" -f "${BUILDROOT}/${dropbear_keyfile}" > /dev/null 2>&1
    fi
    fingerprint=$(dropbearkey -y -f "${BUILDROOT}/${dropbear_keyfile}" | sed -n '/^Fingerprint:/ {s/Fingerprint: *//; p}')
    plain "$(basename "${dropbear_keyfile}"): ${fingerprint}"
  done
}

build_ssh_openssh() {
  if ! pacman -Qi openssh >/dev/null 2>&1; then
    die "Package openssh not installed"
  fi

  plain "Using openssh SSH daemon"

  add_binary 'sshd'
  add_binary '/usr/lib/ssh/sshd-session'
  add_binary '/usr/lib/ssh/sshd-auth'

  # OpenSSH requires the "nobody" user to be present.
  grep "nobody" "/etc/passwd" > "${BUILDROOT}/etc/passwd"
  grep "nobody" "/etc/group" > "${BUILDROOT}/etc/group"

  mkdir -p ${BUILDROOT}/etc/ssh/
  cat <<EOF >> "${BUILDROOT}/etc/ssh/sshd_config"
PidFile                       /.sshd.pid
SyslogFacility                AUTHPRIV
PermitRootLogin               prohibit-password
AuthorizedKeysFile            .ssh/authorized_keys
KbdInteractiveAuthentication  no
AuthenticationMethods         publickey
UsePAM                        no
DisableForwarding             yes
EOF

  # OpenSSH requires the "/usr/share/empty.sshd" folder to be present.
  mkdir -p ${BUILDROOT}/usr/share/empty.sshd
  chmod 711 ${BUILDROOT}/usr/share/empty.sshd

  # Setup server keys.
  local openssh_keyfile
  for keytype in "${ssh_key_types[@]}"; do
    openssh_keyfile=${openssh_keyfile_prefix}${keytype}${openssh_keyfile_suffix}
    if [ -e "${openssh_keyfile}" ]; then
      quiet "Copying OpenSSH ${keytype} host key ..."
      add_file "${openssh_keyfile}"

      fingerprint=$(ssh-keygen -lf "${openssh_keyfile}" | cut -d' ' -f2)
      plain "$(basename "${openssh_keyfile}"): ${fingerprint}"
    fi
  done
}

help() {
  cat <<EOF
This hook allows for LUKS encrypted devices to be unlocked either locally
(boot console) or remotely over SSH.

Network is configured with 'ip=' kernel parameter (see 'mkinitcpio-nfs-utils').
Authorized SSH key(s) must be present in '/etc/initcpio/sshcs_authorized_keys'.
LUKS encrypted devices to unlock are derived from '/etc/crypttab', which must
be present.
Some options can be set in '/etc/initcpio/sshcs_env'.
See the README for more details.

Each SSH server key ('rsa', 'ecdsa' and/or 'ed25519'; see README for locations)
is copied from SSH daemon configuration directory, converted from OpenSSH if
present, or generated if missing. Fingerprints are displayed upon building the
initramfs image.
EOF
}
