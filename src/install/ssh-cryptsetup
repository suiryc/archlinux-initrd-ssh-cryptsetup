#!/bin/bash

sshcs_check_nonempty() {
  local filepath="$1"

  [ -e "${filepath}" ] && grep -Eqv '^\s*(#|$)' "${filepath}"
}

build() {
  . /usr/lib/initcpio/hooks/ssh-cryptsetup-env

  local etc_crypttab='/etc/crypttab'
  local sshcs_authorized_keys='/etc/initcpio/sshcs_authorized_keys'
  local ssh_key_types=( 'rsa' 'ecdsa' 'ed25519' )
  local dropbear_keyfile_prefix='/etc/dropbear/dropbear_'
  local dropbear_keyfile_suffix='_host_key'
  local openssh_keyfile_prefix='/etc/ssh/ssh_host_'
  local openssh_keyfile_suffix='_key'
  local root_authorized_keys='/root/.ssh/authorized_keys'

  # Check we are needed
  if ! sshcs_check_nonempty "${sshcs_authorized_keys}"; then
    plain "There is no root key(s) in ${sshcs_authorized_keys}. Skipping."
    return 0
  fi
  if ! sshcs_check_nonempty "${etc_crypttab}"; then
    plain "There is no device in ${etc_crypttab}. Skipping."
    return 0
  fi

  # Only consider entries marked with 'x-initrd.attach'.
  if ! grep -Ev '^\s*(#|$)' "${etc_crypttab}" | grep -Eq '(\s|,)x-initrd\.attach(\s|,|$)'; then
    plain "There is no 'x-initrd.attach' device in ${etc_crypttab}. Skipping."
    return 0
  fi

  umask 0022

  local sd_on=0
  if [ -e "${BUILDROOT}/usr/bin/systemctl" ]; then
    plain 'Building for systemd setup'
    sd_on=1
    build_sd
  else
    plain 'Building for non-systemd setup'
  fi

  # Note: parts of this script (modules/binaries/files added) are the same than
  # other install scripts (/usr/lib/initcpio/install/):
  #   - 'encrypt': nominal support of encrypted volumes at boot time
  #   - 'net': network tools

  ## Modules
  # (from 'encrypt')
  add_module 'dm-crypt'
  add_module 'dm-integrity'
  if [[ $CRYPTO_MODULES ]]; then
    local mod
    for mod in $CRYPTO_MODULES; do
      add_module "$mod"
    done
  else
    add_all_modules '/crypto/'
  fi

  # (from 'net')
  add_checked_modules '/drivers/net/'


  ## Binaries
  # (from 'encrypt')
  add_binary 'cryptsetup'
  # cryptsetup calls pthread_create(), which dlopen()s libgcc_s.so.1
  # Note: at least necessary for LUKS v2 volumes.
  # Also see similar/related bug reports (e.g. https://bugs.debian.org/cgi-bin/bugreport.cgi?bug=950254).
  add_binary '/usr/lib/libgcc_s.so.1'

  # (from 'net')
  add_binary '/usr/lib/initcpio/ipconfig' '/bin/ipconfig'

  # (ours)
  # Note: dmsetup is necessary for device mapper features
  add_binary 'dmsetup'
  add_binary 'ip'
  add_binary 'ethtool'


  ## Other files
  # (from 'encrypt')
  # cryptsetup-related files
  map add_udev_rule \
      '10-dm.rules' \
      '13-dm-disk.rules' \
      '95-dm-notify.rules'

  # (ours)
  # Our script and options
  [ -e "${sshcs_env}" ] && add_file "${sshcs_env}"
  # Note: use /usr/local/bin, even though everything actually points to /usr/bin
  # in initramfs.
  add_file '/usr/lib/initcpio/hooks/ssh-cryptsetup-env' '/usr/local/bin/ssh-cryptsetup-env'
  add_file '/usr/lib/initcpio/hooks/ssh-cryptsetup-tools' '/usr/local/bin/ssh-cryptsetup-tools'

  # crypt partitions
  # When using systemd, sd-encrypt will take care of this. And the way it is done,
  # a bug would create an empty file if the file already exists. So don't do it
  # on our side.
  if [ ${sd_on} -eq 0 ]; then
    add_file "${etc_crypttab}"
  fi

  # SSH-related things
  build_ssh

  add_runscript
}

build_sd() {
  # Command used to unlock devices.
  sshcs_cryptsetup_script='systemd-tty-ask-password-agent --query --watch'

  # systemctl relies on 'less', and busybox variant is not good enough, making
  # it painful to interact with systemd.
  if [ ${sshcs_opt_use_shell} -ne 0 ]; then
    add_binary 'less'
  fi
  # systemd-networkd-wait-online is used to wait for IP setup
  add_binary '/usr/lib/systemd/systemd-networkd-wait-online'

  # Also include terminal information:
  #  - linux: pure console
  #  - xterm-256color: used by SSH
  for term in 'l/linux' 'x/xterm-256color'
  do
    add_file "/usr/share/terminfo/${term}"
  done
  add_symlink '/lib/terminfo' '/usr/share/terminfo'

  # Our systemd dedicated helper script
  add_file '/usr/lib/initcpio/hooks/ssh-cryptsetup-sd' '/usr/local/bin/ssh-cryptsetup-sd' 755

  # We will setup a few systemd units.
  add_dir '/etc/systemd/system'

  # Timer, triggered if devices are not unlocked after a certain time.
  cat <<EOF >> "${BUILDROOT}/etc/systemd/system/initrd-sshcs-timeout.service"
[Unit]
Description=sshcs disk unlocking timeout timer
DefaultDependencies=no

[Service]
Type=oneshot
ExecStart=/usr/local/bin/ssh-cryptsetup-sd timeout
StandardOutput=tty
StandardError=tty
TTYPath=/dev/console
EOF
  cat <<EOF >> "${BUILDROOT}/etc/systemd/system/initrd-sshcs-timeout.timer"
[Unit]
Description=sshcs disk unlocking timeout service
DefaultDependencies=no

[Timer]
OnActiveSec=${sshcs_opt_timeout_poweroff}s
AccuracySec=1s
Unit=initrd-sshcs-timeout.service

[Install]
WantedBy=sysinit.target
EOF
  if [ ${sshcs_opt_timeout_poweroff} -gt 0 ]; then
    add_symlink '/etc/systemd/system/sysinit.target.wants/initrd-sshcs-timeout.timer' '/etc/systemd/system/initrd-sshcs-timeout.timer'
  fi

  # Service running before unlocking devices.
  cat <<EOF >> "${BUILDROOT}/etc/systemd/system/initrd-sshcs-pre.service"
[Unit]
Description=sshcs pre hook
DefaultDependencies=no
Requires=systemd-network-generator.service
After=systemd-network-generator.service
#After=systemd-networkd.service
Before=systemd-cryptsetup@secured.service cryptsetup.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/ssh-cryptsetup-sd pre
StandardOutput=tty
StandardError=tty
TTYPath=/dev/console
TTYReset=yes

[Install]
WantedBy=cryptsetup.target
EOF
  add_symlink '/etc/systemd/system/cryptsetup.target.wants/initrd-sshcs-pre.service' '/etc/systemd/system/initrd-sshcs-pre.service'

  # Service running after successful devices unlocking.
  cat <<EOF >> "${BUILDROOT}/etc/systemd/system/initrd-sshcs-post.service"
[Unit]
Description=sshcs post hook
DefaultDependencies=no
Requires=systemd-cryptsetup@secured.service
After=systemd-cryptsetup@secured.service
Before=initrd-cleanup.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/ssh-cryptsetup-sd post
StandardOutput=tty
StandardError=tty
TTYPath=/dev/console
TTYReset=yes

[Install]
WantedBy=initrd.target
EOF
  add_symlink '/etc/systemd/system/initrd.target.wants/initrd-sshcs-post.service' '/etc/systemd/system/initrd-sshcs-post.service'

  if [ ${sshcs_opt_use_shell} -ne 0 ]; then
    # Service for interactive shell
    cat <<EOF >> "${BUILDROOT}/etc/systemd/system/initrd-sshcs-shell.service"
[Unit]
Description=sshcs shell
DefaultDependencies=no
After=initrd-sshcs-pre.service
Before=initrd-cleanup.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/ssh-cryptsetup-sd shell
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/console
TTYReset=yes

[Install]
WantedBy=initrd.target
EOF
    add_symlink '/etc/systemd/system/initrd.target.wants/initrd-sshcs-shell.service' '/etc/systemd/system/initrd-sshcs-shell.service'
  fi

  # Rely on systemd-networkd and its generator for network setup.
  # Note: the generator does handle the 'ip=...' kernel option, automatically
  # generating the corresponding systemd-networkd configuration files.
  add_systemd_unit 'systemd-networkd.service'
  add_symlink '/etc/systemd/system/sysinit.target.wants/systemd-networkd.service' '/usr/lib/systemd/system/systemd-networkd.service'
  add_systemd_unit 'systemd-network-generator.service'

  # systemd-networkd.service requires user systemd-network
  grep '^systemd-network:' /etc/passwd >> "${BUILDROOT}/etc/passwd"
  grep '^systemd-network:' /etc/shadow >> "${BUILDROOT}/etc/shadow"
  grep '^systemd-network:' /etc/group >> "${BUILDROOT}/etc/group"
}

build_ssh() {
  add_file "${sshcs_authorized_keys}" "${root_authorized_keys}"

  if [ ${sshcs_opt_use_shell} -ne 0 ]; then
    # User will have a full shell, and can call the script if needed.
    cat <<EOF > "${BUILDROOT}${sshcs_shell_script}"
#!/usr/bin/ash

. /usr/local/bin/ssh-cryptsetup-tools

# HOME is / by default otherwise
export HOME=/root

echo ''
echo "Call ${sshcs_cryptsetup_script} to try unlocking device(s)"
echo '(available in shell history)'
echo ''

# Now give the user its shell
/usr/bin/ash -i +m

# Check whether we are fully done
sshcs_check_done 1
EOF
    chmod a+x "${BUILDROOT}${sshcs_shell_script}"

    # Add command to unlock disks in shell history for easier use
    echo "${sshcs_cryptsetup_script}" >> "${BUILDROOT}/root/.ash_history"
    chmod 600 "${BUILDROOT}/root/.ash_history"
  elif [ ${sd_on} -ne 0 ]; then
    cat <<EOF > "${BUILDROOT}${sshcs_shell_script}"
#!/usr/bin/ash

exec ${sshcs_cryptsetup_script}
EOF
    chmod a+x "${BUILDROOT}${sshcs_shell_script}"
  fi

  # Root user in /etc/passwd
  if [ -e "${BUILDROOT}/etc/passwd" ]; then
    # root user may have been provisioned by another hook already.
    sed -i '/^root:/d' "${BUILDROOT}/etc/passwd"
  fi
  echo "root:x:0:0:root:/root:${sshcs_shell_script}" >> "${BUILDROOT}/etc/passwd"
  echo "${sshcs_shell_script}" >> "${BUILDROOT}/etc/shells"

  # SSH daemon often uses /var/log/lastlog for tracking login information.
  # And dropbear also tries to update /var/log/wtmp and /var/run/utmp (/run).
  add_dir '/var/log'
  touch "${BUILDROOT}/var/log/lastlog"
  touch "${BUILDROOT}/var/log/wtmp"

  if [ "${sshcs_opt_ssh_daemon}" == 'openssh' ]; then
    build_ssh_openssh
  elif [ "${sshcs_opt_ssh_daemon}" == 'tinyssh' ]; then
    build_ssh_tinyssh
  else
    build_ssh_dropbear
  fi
}

build_ssh_service_deps() {
  local drop_in=(
    '[Unit]'
    'Requires=initrd-sshcs-pre.service'
    'After=initrd-sshcs-pre.service'
    'DefaultDependencies=no'
  )
  printf "%s\n" "${drop_in[@]}" | add_systemd_drop_in "$1" override
}

build_ssh_dropbear() {
  if ! pacman -Qi dropbear >/dev/null 2>&1; then
    die 'Package dropbear not installed'
  fi

  plain 'Using dropbear SSH daemon'

  add_binary 'dropbear'

  add_dir $(dirname "${dropbear_keyfile_prefix}")

  # Setup server keys.
  local dropbear_keyfile
  local openssh_keyfile
  local fingerprint
  for keytype in "${ssh_key_types[@]}"; do
    dropbear_keyfile=${dropbear_keyfile_prefix}${keytype}${dropbear_keyfile_suffix}
    openssh_keyfile=${openssh_keyfile_prefix}${keytype}${openssh_keyfile_suffix}

    # Use existing dropbear keys if any.
    # Otherwise, prefer OpenSSH keys.
    # Or generate missing ones.
    if [ -e "${dropbear_keyfile}" ]; then
      quiet "Copying Dropbear ${keytype} host key ..."
      add_file "${dropbear_keyfile}"
    elif [ -e "${openssh_keyfile}" ]; then
      quiet "Converting OpenSSH ${keytype} host key for dropbear ..."
      dropbearconvert openssh dropbear "${openssh_keyfile}" "${BUILDROOT}/${dropbear_keyfile}" > /dev/null 2>&1
    elif [ ! -e "${dropbear_keyfile}" ]; then
      quiet "Generating ${keytype} host key for dropbear ..."
      dropbearkey -t "${keytype}" -f "${BUILDROOT}/${dropbear_keyfile}" > /dev/null 2>&1
    fi
    fingerprint=$(dropbearkey -y -f "${BUILDROOT}/${dropbear_keyfile}" | sed -n '/^Fingerprint:/ {s/Fingerprint: *//; p}')
    plain "$(basename "${dropbear_keyfile}"): ${fingerprint}"
  done

  if [ ${sd_on} -eq 0 ]; then
    return
  fi

  add_systemd_unit 'dropbear.service'
  add_symlink '/etc/systemd/system/sysinit.target.wants/dropbear.service' '/usr/lib/systemd/system/dropbear.service'
  build_ssh_service_deps 'dropbear.service'
}

build_ssh_tinyssh() {
  if ! pacman -Qi tinyssh >/dev/null 2>&1; then
    die 'Package tinyssh not installed'
  fi

  plain 'Using tinyssh SSH daemon'

  add_binary 'tinysshd'

  # Ensure authorized key is ed25519
  grep '^ssh-ed25519 ' "${sshcs_authorized_keys}" > "${BUILDROOT}/${root_authorized_keys}"
  if [ ! -s "${BUILDROOT}/${root_authorized_keys}" ]; then
    die 'Missing ed25519 authorized key'
  fi

  # Setup server key.
  local tinyssh_keydir='/etc/tinyssh/sshkeydir'
  local openssh_keyfile='/etc/ssh/ssh_host_ed25519_key'
  add_dir $(dirname "${tinyssh_keydir}")
  if [ -e "${tinyssh_keydir}/ed25519.pk" ] && [ -e "${tinyssh_keydir}/.ed25519.sk" ]; then
    quiet 'Copying tinyssh ed25519 host key ...'
    add_file "${tinyssh_keydir}/ed25519.pk" "${tinyssh_keydir}/ed25519.pk"
    add_file "${tinyssh_keydir}/.ed25519.sk" "${tinyssh_keydir}/.ed25519.sk"
  elif [ -e "${openssh_keyfile}" ]; then
    quiet 'Converting OpenSSH ed25519 host key for tinyssh ...'
    tinyssh-convert "${BUILDROOT}/${tinyssh_keydir}" < "${openssh_keyfile}"
  else
    die 'Missing ed25519 key file'
  fi

  fingerprint=$(tinysshd-printkey "${BUILDROOT}/${tinyssh_keydir}" | ssh-keygen -lf - | cut -d' ' -f2)
  plain ".ed25519.sk: ${fingerprint}"

  if [ ${sd_on} -eq 0 ]; then
    return
  fi

  add_systemd_unit 'tinyssh@.socket'
  add_systemd_unit 'tinyssh@.service'
  add_symlink "/etc/systemd/system/sysinit.target.wants/tinyssh@${sshcs_opt_port}.socket" '/usr/lib/systemd/system/tinyssh@.socket'
  build_ssh_service_deps "tinyssh@${sshcs_opt_port}.socket"

  drop_in=(
    "[Unit]"
    "DefaultDependencies=no"
    "CollectMode=inactive-or-failed"
    ""
    "[Service]"
    "ExecStart="
    "ExecStart=-/usr/bin/tinysshd ${SD_TINYSSH_COMMAND:+-e '${SD_TINYSSH_COMMAND}' }${tinyssh_keydir}"
  )
  printf "%s\n" "${drop_in[@]}" | add_systemd_drop_in 'tinyssh@.service' override
}

build_ssh_openssh() {
  if ! pacman -Qi openssh >/dev/null 2>&1; then
    die 'Package openssh not installed'
  fi

  plain 'Using openssh SSH daemon'

  add_binary 'sshd'
  add_binary '/usr/lib/ssh/sshd-session'
  add_binary '/usr/lib/ssh/sshd-auth'

  # OpenSSH requires the 'nobody' user to be present.
  grep 'nobody' '/etc/passwd' >> "${BUILDROOT}/etc/passwd"
  grep 'nobody' '/etc/group' >> "${BUILDROOT}/etc/group"

  add_dir '/etc/ssh/'
  cat <<EOF >> "${BUILDROOT}/etc/ssh/sshd_config"
PidFile                       /.sshd.pid
SyslogFacility                AUTHPRIV
PermitRootLogin               prohibit-password
AuthorizedKeysFile            .ssh/authorized_keys
PasswordAuthentication        no
KbdInteractiveAuthentication  no
AuthenticationMethods         publickey
UsePAM                        no
DisableForwarding             yes
EOF

  # OpenSSH requires the '/usr/share/empty.sshd' folder to be present.
  add_dir '/usr/share/empty.sshd' 711

  # Setup server keys.
  local openssh_keyfile
  for keytype in "${ssh_key_types[@]}"; do
    openssh_keyfile=${openssh_keyfile_prefix}${keytype}${openssh_keyfile_suffix}
    if [ -e "${openssh_keyfile}" ]; then
      quiet "Copying OpenSSH ${keytype} host key ..."
      add_file "${openssh_keyfile}"

      fingerprint=$(ssh-keygen -lf "${openssh_keyfile}" | cut -d' ' -f2)
      plain "$(basename "${openssh_keyfile}"): ${fingerprint}"
    fi
  done

  if [ ${sd_on} -eq 0 ]; then
    return
  fi

  add_systemd_unit 'sshd.service'
  add_symlink '/etc/systemd/system/sysinit.target.wants/sshd.service' '/usr/lib/systemd/system/sshd.service'
  build_ssh_service_deps 'sshd.service'
}

help() {
  cat <<EOF
This hook allows for LUKS encrypted devices to be unlocked either locally
(boot console) or remotely over SSH.

Network is configured with 'ip=' kernel parameter (see 'mkinitcpio-nfs-utils').
Authorized SSH key(s) must be present in '/etc/initcpio/sshcs_authorized_keys'.
LUKS encrypted devices to unlock are derived from '/etc/crypttab', which must
be present.
Some options can be set in '/etc/initcpio/sshcs_env'.
See the README for more details.

Each SSH server key ('rsa', 'ecdsa' and/or 'ed25519'; see README for locations)
is copied from SSH daemon configuration directory, converted from OpenSSH if
present, or generated if missing. Fingerprints are displayed upon building the
initramfs image.
EOF
}
