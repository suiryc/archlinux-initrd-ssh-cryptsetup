#!/bin/bash

post_install() {
  local sshcs_authorized_keys="/etc/initcpio/sshcs_authorized_keys"
  local dropbear_authorized_keys="/etc/dropbear/initrd.authorized_keys"
  local etc_initcpio=$(dirname "${sshcs_authorized_keys}")
  [ ! -e "${sshcs_authorized_keys}" ] && [ -e "${dropbear_authorized_keys}" ] && {
    [ -d $(dirname "${sshcs_authorized_keys}") ] || mkdir -p $(dirname "${sshcs_authorized_keys}")
    mv "${dropbear_authorized_keys}" "${sshcs_authorized_keys}"
    rmdir $(dirname "${dropbear_authorized_keys}") 2>/dev/null
    cat <<EOF
    Moved legacy file ${dropbear_authorized_keys} to new path ${sshcs_authorized_keys}"
EOF
  }
  [ -d "${etc_initcpio}" ] || mkdir -p "${etc_initcpio}"
  [ -e "${sshcs_authorized_keys}" ] || touch "${sshcs_authorized_keys}"
  chmod 600 "${sshcs_authorized_keys}"

  cat <<EOF
    Install either 'dropbear', 'openssh' or 'tinyssh' package for SSH handling,
    and configure it in '/etc/initcpio/sshcs_env' if necessary.

    Generate dedicated server keys if nominal (after boot) ones are protected
    (e.g. on an encrypted disk).

    Add the SSH client public key to '${sshcs_authorized_keys}'.

    Add the 'ip=' kernel command parameter to the bootloader configuration
    (see https://wiki.archlinux.org/index.php/Mkinitcpio#Using_net).

    In the 'HOOKS' section of '/etc/mkinitcpio.conf', add 'ssh-cryptsetup'
    before 'filesystems'.

    Then rebuild the initramfs: 'mkinitcpio -p linux'
EOF
}

post_remove() {
  cat <<EOF
    Remove the 'ip=' kernel command parameter from the bootloader configuration.

    In the 'HOOKS' section of '/etc/mkinitcpio.conf', remove 'ssh-cryptsetup'.

    Then rebuild the initramfs: 'mkinitcpio -p linux'
EOF
}

post_upgrade() {
  post_install
}
